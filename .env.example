# Copy to .env locally only if you need overrides. Never commit .env.
STUDX_PORT=4310
STUDX_HOST=127.0.0.1

# Secret values should be stored in macOS Keychain. These are key names only.
STUDX_NOTION_KEYCHAIN_ITEM=studx/notion/api-token
STUDX_CLICKUP_KEYCHAIN_ITEM=studx/clickup/api-token
STUDX_GOOGLE_KEYCHAIN_ITEM=studx/google/oauth-client
STUDX_GITHUB_KEYCHAIN_ITEM=studx/github/token
STUDX_GITEA_KEYCHAIN_ITEM=studx/gitea/token
STUDX_BASE44_KEYCHAIN_ITEM=studx/base44/api-token

OLLAMA_BASE_URL=http://127.0.0.1:11434
MLX_BASE_URL=http://127.0.0.1:8080
